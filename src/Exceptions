import java.io.File;
import java.io.FileNotFoundException;
import java.util.Scanner;

public class ExceptionsDemo {
    public static void main(String[] args) {
        
        // 1. Checked Exception (Проверяемое)
        // Компилятор заставляет обрабатывать, т.к. файла физически может не быть в системе
        try {
            File file = new File("test.txt");
            Scanner scanner = new Scanner(file);
        } catch (FileNotFoundException e) {
            System.out.println("Файл не найден, но программа работает дальше");
        }

        // 2. Unchecked Exceptions (RuntimeException)
        // Ошибки программиста. Оборачивать в try-catch их НЕ НАДО, надо просто чинить код.
        // Строки закомментированы, чтобы программа не падала при запуске:
        
        // int a = 1 / 0; // ArithmeticException

        // String s = null;
        // s.length(); // NullPointerException

        // int[] arr = new int[2]; 
        // System.out.println(arr[2]); // ArrayIndexOutOfBoundsException
        
        // Ловить RuntimeException в catch технически можно, но бессмысленно 
    }
}
